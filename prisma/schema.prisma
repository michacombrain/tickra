generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  avatarColor  String          @default("#3b82f6")
  createdAt    DateTime        @default(now())
  ownedProjects Project[]      @relation("ProjectOwner")
  memberships  ProjectMember[]
  assignedIssues Issue[]       @relation("IssueAssignee")
  reportedIssues Issue[]       @relation("IssueReporter")
  comments     Comment[]
}

model Project {
  id           String          @id @default(cuid())
  key          String          @unique
  name         String
  description  String?
  issueCounter Int             @default(0)
  ownerId      String
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members      ProjectMember[]
  sprints      Sprint[]
  issues       Issue[]
  labels       Label[]
  createdAt    DateTime        @default(now())
}

model ProjectMember {
  projectId String
  userId    String
  role      String  @default("MEMBER") // ADMIN | MEMBER
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Sprint {
  id        String    @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime  @default(now())
}

model Issue {
  id          String       @id @default(cuid())
  key         String       @unique // z.B. PROJ-42
  title       String
  description String?
  type        String       @default("TASK") // STORY | TASK | BUG | EPIC
  status      String       @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String       @default("MEDIUM") // HIGHEST | HIGH | MEDIUM | LOW | LOWEST
  order       Float        @default(0)
  storyPoints Int?
  dueDate     DateTime?
  projectId   String
  sprintId    String?
  assigneeId  String?
  reporterId  String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User         @relation("IssueReporter", fields: [reporterId], references: [id])
  comments    Comment[]
  labels      IssueLabel[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  editedAt  DateTime?
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Label {
  id        String       @id @default(cuid())
  projectId String
  name      String
  color     String       @default("#6b7280")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@unique([projectId, name])
}

model IssueLabel {
  issueId String
  labelId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}
